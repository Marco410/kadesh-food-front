# API REST base URL (include /api/v1)
VITE_BACKEND=http://localhost:3000/api/v1

# Socket.IO server URL (same host as backend, without /api path)
VITE_BACKEND_SOCKET_IO=http://localhost:3000

# Base URL for images served by the backend
VITE_BACKEND_IMAGES_BASE_URL=http://localhost:3000

# Public frontend URL (used for links, redirects, etc.)
VITE_FRONTEND_DOMAIN=http://localhost:5173

# Stripe Price ID for subscription plans
VITE_STRIPE_PRODUCT_SUBSCRIPTION_KEY=price_xxxxxxxxxxxxxxxx
